m=bubblesort;f=bubblesort(arr:@i64):@i64{let n=arr.len;let result=mut.arr;let sorted=mut.false;lp(let i=0;i<n;i=i+1){sorted=false;lp(let j=0;j<n-1-i;j=j+1){if(result.get(j)>result.get(j+1)){let temp=result.get(j);result=result.set(j;result.get(j+1));result=result.set(j+1;temp);sorted=true}el{};};if(sorted){br}el{};};<result};
